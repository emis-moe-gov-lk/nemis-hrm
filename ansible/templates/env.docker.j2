APP_NAME=Laravel
APP_ENV={{ app_env }}
APP_KEY=
APP_DEBUG={{ app_debug }}
APP_URL={{ app_url }}
DOCKER_APP_PORT={{ docker_app_port }}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
